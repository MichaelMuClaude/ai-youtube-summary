{
  "manifest_version": 3,
  "name": "YouTube Video Summary",
  "version": "0.1.0",
  "description": "Fetch YouTube video transcripts and summaries via ai-youtube-summary.",
  "permissions": [
    "tabs",
    "sidePanel",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:9877/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
}
